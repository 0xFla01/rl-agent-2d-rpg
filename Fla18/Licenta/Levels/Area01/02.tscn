text = "No, not now."

[node name="DialogTextNo" type="Node" parent="Oren/DialogInteraction/DialogChoice/BranchNo" unique_id=268957029]
script = ExtResource("43_dltxt")
text = "I understand... If you change your mind, the dungeon is to the north. I will be waiting here."

