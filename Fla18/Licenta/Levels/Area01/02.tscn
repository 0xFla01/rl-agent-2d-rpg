[node name="DialogText" type="Node" parent="Oren/DialogInteraction" unique_id=883782115]
script = ExtResource("43_dltxt")
text = "Traveler! Thank goodness you're here. A dark wizard has taken over the dungeon to the north and threatens these lands. I cannot face him alone... Will you help me?"

[node name="DialogChoice" type="Node" parent="Oren/DialogInteraction" unique_id=476426832]
script = ExtResource("44_dlcho")

[node name="BranchYes" type="Node" parent="Oren/DialogInteraction/DialogChoice" unique_id=1970368138]
script = ExtResource("45_dlbra")
text = "Yes, I will help."

[node name="DialogTextYes" type="Node" parent="Oren/DialogInteraction/DialogChoice/BranchYes" unique_id=178418136]
script = ExtResource("43_dltxt")
text = "You have my eternal gratitude, hero! The dungeon entrance is to the north. Please... be careful in there."

